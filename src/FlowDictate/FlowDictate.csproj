<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF> <!-- for System.Windows.Automation (UIA text insertion) -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>FlowDictate</AssemblyName>
    <RootNamespace>FlowDictate</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>FlowDictate</Product>
    <Authors>Shruti</Authors>
    <Description>Hotkey-driven AI dictation for Windows: on-device Whisper transcription, Claude-powered cleanup, works in every app.</Description>
    <Copyright>© 2026 Shruti · MIT License</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="*" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

</Project>
